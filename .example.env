# Copy to .env and fill in. .env is gitignored.

# OpenRouter API key, used to label questions by topic with free models. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated free vision models, tried in order when one is unavailable
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free

# Optional: page images per request (default 6). Free models allow 50 requests/day.
# IMAGES_PER_REQUEST=6
