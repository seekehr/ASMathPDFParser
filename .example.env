# Copy to .env and fill in. .env is gitignored.

# Gemini API key, used to label questions by topic. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: free-tier tuning. Questions per request (default 110, so 3 requests for all 326)
# and minimum seconds between requests (default 30). Lower the batch size if you hit token-per-minute limits.
# GEMINI_BATCH_SIZE=110
# GEMINI_MIN_INTERVAL_S=30
